{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/elysia/**/*.ts",
    "src/LeavelDB/**/*.ts",
    "bun/**/*.ts",
    "node/**/*.ts",
    "cf/**/*.ts",
    "adapters/**/*.ts",
    "core/**/*.ts",
    "index.ts",
    "../src/api/**/*.ts",
    "../src/elysia/apiV1.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
