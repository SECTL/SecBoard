# SecBoard Production Environment Configuration
# Copy to .env and fill in real values

# --- Server ---
NODE_ENV=production
LANSTART_BACKEND_HOST=0.0.0.0
LANSTART_BACKEND_PORT=3131
LANSTART_CAST_HOST=0.0.0.0
LANSTART_CAST_PORT=3132

# --- Database ---
LANSTART_DB_PATH=./data/lanstart.sqlite

# --- Security (CRITICAL for public deployment) ---
LANSTART_ALLOWED_ORIGINS=https://yourdomain.com

# Shared secret token. Clients must send: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
# If empty, authentication is DISABLED (only safe for local/trusted networks).
LANSTART_API_TOKEN=

# CS proxy host whitelist (comma-separated). Default: only LANSTART_CS_BASE_URL host.
LANSTART_CS_BASE_URL=
LANSTART_CS_ALLOW_HOSTS=

# --- Logging ---
LOG_LEVEL=info
