{
  "name": "secboard",
  "description": "SecBoard - 网页白板与视频展台",
  "author": "LanStart",
  "private": true,
  "version": "1.0.0",
  "lanstartCodename": "Viweivi",
  "scripts": {
    "dev": "bun run dev:all",
    "dev:all": "concurrently -k -n backend,web \"bun run dev:backend\" \"bun run dev:web\"",
    "dev:web": "vite --config vite.config.ts",
    "dev:backend": "bun --watch src/elysia/index.ts",
    "dev:frontend": "vite --config vite.config.ts --mode frontend",
    "build": "vite build --config vite.config.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build --config vite.config.ts --mode frontend",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "release": "release-it",
    "dev:backend:bun": "cd backend && bun run dev:bun",
    "dev:backend:node": "cd backend && bun run dev:node",
    "build:backend:bun": "cd backend && bun run build:bun",
    "build:backend:cf": "cd backend && bun run build:cf"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.285",
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "better-sqlite3": "^12.10.0",
    "elysia": "^1.4.3",
    "fast-xml-parser": "^5.3.6",
    "framer-motion": "^12.29.2",
    "leafer-ui": "^2.0.0",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "release-it": "^19.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.1.9"
  }
}
