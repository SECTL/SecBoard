{
  "name": "secboard-cf",
  "version": "1.0.0",
  "description": "SecBoard Cloudflare Workers Backend",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:d1": "wrangler d1 execute secboard-db --file=./schema.sql --remote",
    "dev:d1": "wrangler d1 execute secboard-db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "itty-router": "^5.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.95.0"
  },
  "packageManager": "pnpm@9.0.0"
}
