yourdomain.com {
    encode gzip zstd

    @static path *.js *.css *.woff2 *.ttf *.otf *.svg *.png *.jpg *.jpeg *.webp *.gif *.ico
    header @static Cache-Control "public, max-age=31536000, immutable"

    reverse_proxy /rpc/* localhost:3131
    reverse_proxy /kv/* localhost:3131
    reverse_proxy /ui/* localhost:3131
    reverse_proxy /ui-state/* localhost:3131
    reverse_proxy /events* localhost:3131
    reverse_proxy /webrtc/* localhost:3132
    reverse_proxy /cunox/* localhost:3131
    reverse_proxy /img/* localhost:3131
    reverse_proxy /cs/* localhost:3131
    reverse_proxy /dialog/* localhost:3131
    reverse_proxy /health localhost:3131

    root * /opt/secboard/dist/web
    try_files {path} {path}/ /index.html
    file_server
}
