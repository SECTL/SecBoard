[Unit]
Description=SecBoard Backend Service
Documentation=https://github.com/your-org/SecBoard
After=network.target

[Service]
Type=simple
User=secboard
Group=secboard
WorkingDirectory=/opt/secboard
EnvironmentFile=/opt/secboard/.env
ExecStart=/usr/local/bin/bun run src/elysia/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secboard

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/secboard/data /opt/secboard/logs

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
